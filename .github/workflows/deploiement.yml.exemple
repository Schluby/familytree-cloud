# Variante à la construction Cloudflare (voir DEPLOIEMENT.md).
#
# Pour l'activer : renommer ce fichier en « deploiement.yml », puis créer dans
# GitHub (Settings → Secrets and variables → Actions) :
#   CLOUDFLARE_API_TOKEN   — jeton avec Workers Scripts:Edit ET D1:Edit
#   CLOUDFLARE_ACCOUNT_ID  — visible dans le tableau de bord Cloudflare
#
# N'activer QU'UN des deux mécanismes : sinon chaque push déploie deux fois.

name: Déploiement

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  deployer:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version-file: .node-version
          cache: npm

      - run: npm ci

      # Le typage échoue avant le déploiement plutôt qu'après.
      - run: npx tsc --noEmit

      # Migrations puis déploiement, dans cet ordre : le nouveau code ne doit
      # jamais rencontrer l'ancien schéma.
      - run: npm run deploy
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
