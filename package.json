{
  "name": "familytree-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FamilyTree hébergé — un Worker Cloudflare + une base D1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "base:local": "wrangler d1 migrations apply familytree --local",
    "base:ligne": "wrangler d1 migrations apply familytree --remote",
    "deploy": "wrangler d1 migrations apply familytree --remote && wrangler deploy",
    "types": "wrangler types",
    "verif": "node outils/verifier-prefixe.mjs && tsc --noEmit && wrangler deploy --dry-run"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
